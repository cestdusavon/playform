{%- liquid
  assign products_per_page = section.settings.products_per_page | default: 12
  assign columns = section.settings.columns | default: 3
-%}

<div class="pf-page">
  <div class="pf-collection-header pf-wrap">
    {%- if collection.image -%}
      <div class="pf-collection-hero">
        {{
          collection.image
          | image_url: width: 1200
          | image_tag:
            alt: collection.title,
            loading: 'eager'
        }}
      </div>
    {%- endif -%}

    <div class="pf-collection-intro">
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="pf-rte">
          {{ collection.description }}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'intro' -%}
          {%- assign pf_intro_mf = collection.metafields.custom.collection_intro -%}
          {%- if pf_intro_mf != blank -%}
            <div class="pf-rte pf-collection-intro__extra" {{ block.shopify_attributes }}>
              {{ pf_intro_mf | metafield_tag }}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="pf-collection-grid-section pf-wrap">
    {%- if collection.products.size > 0 -%}
      {%- paginate collection.products by products_per_page -%}
        <div class="pf-product-grid" style="--pf-grid-cols: {{ columns }};">
          {%- for product in collection.products -%}
            <div class="pf-product-grid-item">
              {% render 'pf-product-card', product: product, placeholder_index: forloop.index %}
            </div>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pf-pagination" aria-label="{{ 'general.pagination.label' | t }}">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="pf-pagination__link">
                {{ 'general.pagination.previous' | t }}
              </a>
            {%- endif -%}

            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="pf-pagination__link">{{ part.title }}</a>
              {%- else -%}
                <span class="pf-pagination__current">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}

            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="pf-pagination__link">
                {{ 'general.pagination.next' | t }}
              </a>
            {%- endif -%}
          </nav>
        {%- endif -%}

        {% render 'pf-collection-jsonld', collection: collection, paginate: paginate %}
      {%- endpaginate -%}
    {%- else -%}
      <p class="pf-text-center">{{ 'collections.general.empty' | t }}</p>
      {% render 'pf-collection-jsonld', collection: collection %}
    {%- endif -%}
  </div>

  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'long_form' -%}
        {%- assign pf_long_mf = collection.metafields.custom.collection_longform -%}
        {%- if pf_long_mf != blank -%}
          <section class="pf-collection-extra pf-wrap" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="pf-collection-extra__heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            <div class="pf-rte pf-collection-longform">
              {{ pf_long_mf | metafield_tag }}
            </div>
          </section>
        {%- endif -%}

      {%- when 'faq' -%}
        {%- liquid
          assign pf_faq_items = collection.metafields.custom.collection_faq.value
          assign pf_faq_count = 0
        -%}
        {%- capture pf_faq_html -%}
          {%- for item in pf_faq_items -%}
            {%- if item.question != blank and item.answer != blank -%}
              {%- assign pf_faq_count = pf_faq_count | plus: 1 -%}
              <details class="pf-faq__item"{% if pf_faq_count == 1 %} open{% endif %}>
                <summary class="pf-faq__question">{{ item.question | escape }}</summary>
                <div class="pf-faq__answer"><p>{{ item.answer | escape | newline_to_br }}</p></div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if pf_faq_count > 0 -%}
          <section class="pf-collection-extra pf-wrap" {{ block.shopify_attributes }}>
            <h2 class="pf-collection-extra__heading">{{ block.settings.heading | default: 'FAQs' | escape }}</h2>
            <div class="pf-faq">{{ pf_faq_html }}</div>
          </section>
          <script type="application/ld+json">
          {
            "@context": "https://schema.org",
            "@type": "FAQPage",
            "mainEntity": [
              {%- assign pf_faq_printed = 0 -%}
              {%- for item in pf_faq_items -%}
                {%- if item.question != blank and item.answer != blank -%}
                  {%- if pf_faq_printed > 0 -%},{%- endif -%}
                  {
                    "@type": "Question",
                    "name": {{ item.question | json }},
                    "acceptedAnswer": {
                      "@type": "Answer",
                      "text": {{ item.answer | json }}
                    }
                  }
                  {%- assign pf_faq_printed = pf_faq_printed | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            ]
          }
          </script>
        {%- endif -%}

      {%- when 'related' -%}
        {%- assign pf_related = collection.metafields.custom.related_collections.value -%}
        {%- capture pf_related_html -%}
          {%- for rel in pf_related -%}
            {%- unless rel.handle == collection.handle -%}
              <a class="pf-related-card" href="{{ rel.url }}">
                {%- if rel.image -%}
                  <span class="pf-related-card__media">
                    {{ rel.image | image_url: width: 480 | image_tag: alt: rel.title, loading: 'lazy' }}
                  </span>
                {%- endif -%}
                <span class="pf-related-card__title">{{ rel.title | escape }}</span>
              </a>
            {%- endunless -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if pf_related_html contains 'pf-related-card' -%}
          <section class="pf-collection-extra pf-wrap" {{ block.shopify_attributes }}>
            <h2 class="pf-collection-extra__heading">{{ block.settings.heading | default: 'Keep exploring' | escape }}</h2>
            <nav class="pf-related-grid" aria-label="{{ block.settings.heading | default: 'Keep exploring' | escape }}">
              {{ pf_related_html }}
            </nav>
          </section>
        {%- endif -%}
    {%- endcase -%}
  {%- endfor -%}
</div>

<style>
  .pf-collection-header {
    padding-top: 32px;
  }

  .pf-collection-hero {
    border-radius: var(--pf-radius, 20px);
    overflow: hidden;
    margin-bottom: 32px;
    max-height: 400px;
  }

  .pf-collection-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pf-collection-intro h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    margin-bottom: 16px;
    font-family: var(--pf-font-display);
    font-weight: 700;
  }

  .pf-collection-intro .pf-rte {
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 600px;
  }

  .pf-collection-grid-section {
    padding: 48px 0;
  }

  .pf-product-grid {
    display: grid;
    grid-template-columns: repeat(var(--pf-grid-cols, 3), 1fr);
    gap: 24px;
    margin-bottom: 48px;
  }

  .pf-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .pf-pagination__link {
    padding: 8px 12px;
    border: 1px solid var(--ptoys-text);
    border-radius: var(--pf-radius, 20px);
    text-decoration: none;
    color: inherit;
    transition: background 0.2s;
  }

  .pf-pagination__link:hover {
    background: var(--ptoys-text);
    color: var(--ptoys-surface);
  }

  .pf-pagination__current {
    padding: 8px 12px;
    font-weight: 600;
  }

  .pf-text-center {
    text-align: center;
  }

  .pf-collection-intro__extra {
    margin-top: 16px;
    max-width: 600px;
    line-height: 1.6;
  }

  .pf-collection-extra {
    padding: 0 0 48px;
  }

  .pf-collection-extra__heading {
    font-family: var(--pf-font-display);
    font-weight: 700;
    font-size: clamp(1.35rem, 3.5vw, 1.75rem);
    margin-bottom: 16px;
  }

  .pf-collection-longform {
    max-width: 720px;
    line-height: 1.7;
  }

  .pf-collection-longform h3 {
    font-family: var(--pf-font-display);
    margin: 24px 0 8px;
  }

  .pf-faq {
    max-width: 720px;
  }

  .pf-faq__item {
    border: 1px solid var(--pf-line, rgba(43, 45, 58, 0.15));
    border-radius: var(--pf-radius, 20px);
    background: var(--ptoys-surface, #fff);
    padding: 4px 20px;
    margin-bottom: 12px;
  }

  .pf-faq__question {
    cursor: pointer;
    font-weight: 700;
    padding: 12px 0;
    list-style-position: inside;
  }

  .pf-faq__answer {
    padding: 0 0 16px;
    line-height: 1.6;
  }

  .pf-related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
  }

  .pf-related-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
    border: 1px solid var(--pf-line, rgba(43, 45, 58, 0.15));
    border-radius: var(--pf-radius, 20px);
    background: var(--ptoys-surface, #fff);
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease;
  }

  .pf-related-card:hover {
    transform: translateY(-2px);
  }

  .pf-related-card__media {
    display: block;
    border-radius: calc(var(--pf-radius, 20px) - 8px);
    overflow: hidden;
  }

  .pf-related-card__media img {
    width: 100%;
    height: 120px;
    object-fit: cover;
    display: block;
  }

  .pf-related-card__title {
    font-weight: 700;
    font-family: var(--pf-font-display);
  }

  @media (max-width: 988px) {
    .pf-product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 748px) {
    .pf-collection-grid-section {
      padding: 32px 0;
    }

    .pf-product-grid {
      /* Two-up on phones, like the original collection grid — a single
         full-width card reads as the product taking over the page. */
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .pf-collection-header {
      padding-top: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Collection product grid",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 12
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "intro",
      "name": "Extended intro",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows the collection metafield custom.collection_intro (rich text) under the description. Collections without the metafield render nothing extra."
        }
      ]
    },
    {
      "type": "long_form",
      "name": "Long-form copy",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows the collection metafield custom.collection_longform (rich text) below the product grid. Collections without the metafield render nothing extra."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows the collection metafield custom.collection_faq (JSON list of question\/answer pairs) as an accordion, with matching FAQPage structured data. Collections without the metafield render nothing extra."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "FAQs"
        }
      ]
    },
    {
      "type": "related",
      "name": "Related collections",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Shows the collection metafield custom.related_collections (list of collections) as link cards — internal linking without nesting the menus."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Keep exploring"
        }
      ]
    }
  ]
}
{% endschema %}
