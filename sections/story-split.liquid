{%- comment -%}
  Image + rich text, alternating sides. Used on the About page but generic.
{%- endcomment -%}

<div class="pf-story" style="background: {{ section.settings.background }};">
  <div class="pf-wrap pf-story__inner{% if section.settings.image_position == 'right' %} pf-story__inner--reverse{% endif %}">
    <div class="pf-story__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1000
          | image_tag: loading: 'lazy', widths: '400, 600, 800, 1000', sizes: '(min-width: 750px) 45vw, 90vw', alt: section.settings.image.alt
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="pf-story__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pf-eyebrow pf-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h2 class="pf-display pf-story__title">{{ section.settings.heading | escape }}</h2>

      {%- if section.settings.text != blank -%}
        <div class="pf-rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a class="pf-btn pf-btn--{{ section.settings.button_color }}" href="{{ section.settings.button_link }}">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Story",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#F8F4EA"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Started in a garage. Still kind of is."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Playform started as a way to make one kid's room feel like theirs. It turned into 3D printers, laser cutters and a workbench that never quite gets tidy \u2014 and a lot of custom pieces for other people's kids, parties and stores.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_color",
      "label": "Button colour",
      "options": [
        {
          "value": "red",
          "label": "Red"
        },
        {
          "value": "yellow",
          "label": "Yellow"
        },
        {
          "value": "blue",
          "label": "Blue"
        },
        {
          "value": "green",
          "label": "Green"
        },
        {
          "value": "purple",
          "label": "Purple"
        },
        {
          "value": "accent",
          "label": "Seasonal accent"
        },
        {
          "value": "accent-secondary",
          "label": "Seasonal accent (secondary)"
        }
      ],
      "default": "red"
    }
  ],
  "presets": [
    {
      "name": "Story"
    }
  ]
}
{% endschema %}
