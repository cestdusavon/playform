{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show | default: 4
  assign columns = section.settings.columns | default: 2
-%}

<div class="pf-featured-collection" style="background: {{ section.settings.background_color }};">
  <div class="pf-wrap">
    {%- if section.settings.heading != blank -%}
      <div class="pf-section-header">
        <h2 class="pf-section-heading">
          {% render 'pf-rainbow', text: section.settings.heading, start_color: section.settings.rainbow_start %}
        </h2>
        {%- if section.settings.subheading != blank -%}
          <p class="pf-section-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if collection != blank and collection.products.size > 0 -%}
      <div class="pf-product-grid" style="--pf-grid-cols: {{ columns }};">
        {%- for product in collection.products limit: products_to_show -%}
          <div class="pf-product-grid-item">
            {% render 'pf-product-card', product: product %}
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.button_label != blank -%}
        <div class="pf-text-center" style="margin-top: 32px;">
          <a href="{{ collection.url }}" class="pf-btn pf-btn--{{ section.settings.button_color }}">
            {{ section.settings.button_label }}
          </a>
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="pf-text-center">{{ 'collections.general.empty' | t }}</p>
    {%- endif -%}
  </div>
</div>

<style>
  .pf-featured-collection {
    padding: 48px 0;
  }

  .pf-section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .pf-section-heading {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    margin: 0 0 16px;
    font-family: var(--pf-font-display);
    font-weight: 700;
  }

  .pf-section-subheading {
    margin: 0;
    font-size: 1.125rem;
    color: #666;
  }

  .pf-product-grid {
    display: grid;
    grid-template-columns: repeat(var(--pf-grid-cols, 2), 1fr);
    gap: 24px;
  }

  .pf-text-center {
    text-align: center;
  }

  @media (max-width: 988px) {
    .pf-product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 748px) {
    .pf-featured-collection {
      padding: 32px 0;
    }

    .pf-product-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .pf-section-header {
      margin-bottom: 32px;
    }
  }
</style>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "rainbow_start",
      "label": "Rainbow line start color",
      "options": [
        { "value": "red", "label": "Red" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "blue", "label": "Blue" },
        { "value": "green", "label": "Green" },
        { "value": "purple", "label": "Purple" }
      ],
      "default": "red"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F8F4EA"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "select",
      "id": "button_color",
      "label": "Button color",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "primary"
    }
  ]
}
{% endschema %}
