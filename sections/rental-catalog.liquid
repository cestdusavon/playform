{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
-%}

<div class="pf-products" style="background: {{ section.settings.background }};">
  <div class="pf-wrap">
    <div class="pf-section-head">
      <h2 class="pf-display pf-section-head__title">{{ section.settings.heading | escape }}</h2>

      {%- if section.settings.button_label != blank -%}
        {%- assign catalog_link = section.settings.button_link | default: collection.url -%}
        <a class="pf-btn pf-btn--outline" href="{{ catalog_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>

    {%- if collection.products.size > 0 -%}
      <div class="pf-products__grid">
        {%- for product in collection.products limit: limit -%}
          {%- assign card_alt = product.featured_media.alt | default: product.title | escape -%}
          <div class="pf-card pf-card--rental">
            <a class="pf-card__media" href="{{ product.url }}">
              {%- if section.settings.show_badge -%}
                <span class="pf-badge pf-badge--blue">Rent me</span>
              {%- endif -%}

              {%- if product.featured_media != blank -%}
                {{
                  product.featured_media
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '220, 330, 440, 660, 800',
                    sizes: '(min-width: 990px) 280px, (min-width: 750px) 33vw, 45vw',
                    alt: card_alt
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </a>

            <h3 class="pf-card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
            {% render 'pf-rental-rates', product: product, layout: 'inline' %}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="pf-rates__intro">
        Pick a rentals collection in the theme editor to list hire pieces here.
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Rental catalogue",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#F8F4EA" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What you can hire." },
    { "type": "collection", "id": "collection", "label": "Rentals collection" },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    { "type": "checkbox", "id": "show_badge", "label": "Show the \"Rent me\" badge", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See every rental" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to the collection." }
  ],
  "presets": [{ "name": "Rental catalogue" }]
}
{% endschema %}
