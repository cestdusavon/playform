{%- liquid
  assign media_position = section.settings.media_position
  assign product_alt = product.featured_media.alt | default: product.title | escape
-%}

<div class="pf-page pf-wrap">
  <div class="pf-product{% if media_position == 'right' %} pf-product--media-right{% endif %}">
    <div class="pf-product__media">
      {%- if product.featured_media != blank -%}
        {{
          product.featured_media
          | image_url: width: 1200
          | image_tag:
            widths: '400, 600, 900, 1200',
            sizes: '(min-width: 750px) 45vw, 90vw',
            alt: product_alt,
            class: 'pf-product__image'
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}

      {%- if section.settings.show_thumbs and product.media.size > 1 -%}
        <div class="pf-product__thumbs">
          {%- for media in product.media -%}
            <button
              class="pf-product__thumb"
              type="button"
              data-pf-media-swap="{{ media | image_url: width: 1200 }}"
              aria-label="{{ media.alt | default: product.title | escape }}">
              {{ media | image_url: width: 160 | image_tag: alt: media.alt, loading: 'lazy' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pf-product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <h1 class="pf-display pf-page__title" {{ block.shopify_attributes }}>
              {{- product.title | escape -}}
            </h1>

          {%- when 'price' -%}
            <p class="pf-product__price" {{ block.shopify_attributes }}>
              {%- if product.compare_at_price > product.price -%}
                <s>{{ product.compare_at_price | money }}</s>
              {%- endif -%}
              {{ product.price | money }}
              {%- if product.price_varies -%}
                <span class="pf-product__price-note">{{ 'products.card.from_price' | t: price: '' | strip }}</span>
              {%- endif -%}
            </p>

          {%- when 'vendor' -%}
            {%- if product.vendor != blank -%}
              <p class="pf-product__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
            {%- endif -%}

          {%- when 'text' -%}
            <div class="pf-rte pf-product__text" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>

          {%- when 'rental_rates' -%}
            <div {{ block.shopify_attributes }}>
              {% render 'pf-rental-rates', product: product, layout: block.settings.layout %}
            </div>

          {%- when 'buy_buttons' -%}
            <div {{ block.shopify_attributes }}>
              {%- form 'product', product -%}
                {%- if product.variants.size > 1 -%}
                  <div class="pf-field">
                    <label for="ProductVariant">
                      {{- product.options_with_values | map: 'name' | join: ' / ' -}}
                    </label>
                    <select id="ProductVariant" name="id">
                      {%- for variant in product.variants -%}
                        <option
                          value="{{ variant.id }}"
                          {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                          {% unless variant.available %}disabled{% endunless %}>
                          {{ variant.title }} &mdash; {{ variant.price | money }}
                        </option>
                      {%- endfor -%}
                    </select>
                  </div>
                {%- else -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                {%- endif -%}

                {%- if block.settings.show_quantity -%}
                  <div class="pf-field">
                    <label for="Quantity">{{ 'products.product.quantity' | t }}</label>
                    <input id="Quantity" type="number" name="quantity" value="1" min="1">
                  </div>
                {%- endif -%}

                <button
                  class="pf-btn pf-btn--{{ block.settings.button_color }}"
                  type="submit"
                  {% unless product.available %}disabled{% endunless %}>
                  {%- if product.available -%}
                    {{ 'products.product.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </button>
              {%- endform -%}
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="pf-rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.settings.show_thumbs -%}
  <script>
    document.addEventListener('click', function (event) {
      var thumb = event.target.closest('[data-pf-media-swap]');
      if (!thumb) return;

      var featured = document.querySelector('.pf-product__image');
      if (!featured) return;

      featured.removeAttribute('srcset');
      featured.removeAttribute('sizes');
      featured.src = thumb.dataset.pfMediaSwap;
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_thumbs",
      "label": "Show thumbnails",
      "info": "Only appears when the product has more than one image.",
      "default": true
    }
  ],
  "blocks": [
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Show quantity", "default": true },
        {
          "type": "select",
          "id": "button_color",
          "label": "Button colour",
          "options": [
            { "value": "red", "label": "Red" },
            { "value": "yellow", "label": "Yellow" },
            { "value": "blue", "label": "Blue" },
            { "value": "green", "label": "Green" },
            { "value": "purple", "label": "Purple" }
          ],
          "default": "red"
        }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "rental_rates",
      "name": "Rental rates",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "options": [
            { "value": "table", "label": "Rate table" },
            { "value": "inline", "label": "Inline" }
          ],
          "default": "table"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [{ "type": "richtext", "id": "text", "label": "Text" }]
    }
  ]
}
{% endschema %}
