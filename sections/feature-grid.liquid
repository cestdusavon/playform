{%- comment -%}
  Generic heading + colour-dot feature list. Used for trade-account
  benefits, brand values, and anywhere else a short reasons-to-believe grid
  is useful. Shares its markup with the deposit page's terms list.
{%- endcomment -%}

<div class="pf-features" style="background: {{ section.settings.background }};">
  <div class="pf-wrap">
    {%- if section.settings.heading != blank -%}
      <div class="pf-section-head pf-section-head--stack">
        <h2 class="pf-display pf-section-head__title">
          <span class="pf-line">{{ section.settings.heading | escape }}</span>
        </h2>
        {%- if section.settings.text != blank -%}
          <p class="pf-rates__intro">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pf-terms pf-terms--standalone">
      {%- for block in section.blocks -%}
        <div class="pf-term" {{ block.shopify_attributes }}>
          <h3 class="pf-term__title">
            <span class="pf-term__dot pf-term__dot--{{ block.settings.color }}" aria-hidden="true"></span>
            {{ block.settings.title | escape }}
          </h3>
          <p class="pf-term__text">{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature grid",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#F8F4EA" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why work with us" },
    { "type": "text", "id": "text", "label": "Intro" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "color",
          "label": "Dot colour",
          "options": [
            { "value": "red", "label": "Red" },
            { "value": "yellow", "label": "Yellow" },
            { "value": "blue", "label": "Blue" },
            { "value": "green", "label": "Green" },
            { "value": "purple", "label": "Purple" }
          ],
          "default": "red"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature grid",
      "blocks": [
        { "type": "feature", "settings": { "color": "red", "title": "Feature one", "text": "Say what makes it worth it." } },
        { "type": "feature", "settings": { "color": "yellow", "title": "Feature two", "text": "Say what makes it worth it." } },
        { "type": "feature", "settings": { "color": "blue", "title": "Feature three", "text": "Say what makes it worth it." } }
      ]
    }
  ]
}
{% endschema %}
