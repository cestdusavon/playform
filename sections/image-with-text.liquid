{%- liquid
  assign image_position = section.settings.image_position
  assign background = section.settings.background_color
  assign layout_class = 'pf-image-with-text--left'
  if image_position == 'right'
    assign layout_class = 'pf-image-with-text--right'
  endif
-%}

<div class="pf-image-with-text {{ layout_class }}" style="background: {{ background }};">
  <div class="pf-wrap">
    <div class="pf-image-with-text__grid">
      <div class="pf-image-with-text__image">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 600
            | image_tag:
              sizes: '(max-width: 748px) 100vw, 50vw',
              widths: '400, 600, 800',
              alt: section.settings.image.alt
          }}
        {%- else -%}
          <div class="pf-image-with-text__placeholder">
            {%- liquid
              echo '<svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg"><rect width="400" height="400" fill="#E8E4DC"/></svg>'
            -%}
          </div>
        {%- endif -%}
      </div>

      <div class="pf-image-with-text__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="pf-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="pf-image-with-text__heading">
            {% render 'pf-rainbow', text: section.settings.heading, start_color: section.settings.rainbow_start %}
          </h2>
        {%- endif -%}

        {%- if section.settings.content != blank -%}
          <div class="pf-rte">
            {{ section.settings.content }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_url }}" class="pf-btn pf-btn--{{ section.settings.button_color }}">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
  .pf-image-with-text {
    padding: 48px 0;
  }

  .pf-image-with-text__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .pf-image-with-text--right .pf-image-with-text__grid {
    direction: rtl;
  }

  .pf-image-with-text--right .pf-image-with-text__content {
    direction: ltr;
  }

  .pf-image-with-text__image {
    border-radius: var(--pf-radius, 20px);
    overflow: hidden;
    background: white;
  }

  .pf-image-with-text__image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .pf-image-with-text__placeholder {
    background: #E8E4DC;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pf-image-with-text__placeholder svg {
    width: 100%;
    height: 100%;
  }

  .pf-image-with-text__content {
    padding: 0;
  }

  .pf-eyebrow {
    margin: 0 0 12px;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .pf-image-with-text__heading {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    margin-bottom: 24px;
    font-family: var(--pf-font-display);
    font-weight: 700;
  }

  .pf-image-with-text .pf-rte {
    font-size: 1.125rem;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  @media (max-width: 988px) {
    .pf-image-with-text__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .pf-image-with-text--right .pf-image-with-text__grid {
      direction: ltr;
    }
  }

  @media (max-width: 748px) {
    .pf-image-with-text {
      padding: 32px 0;
    }

    .pf-image-with-text__grid {
      gap: 24px;
    }
  }
</style>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "rainbow_start",
      "label": "Rainbow line start color",
      "options": [
        { "value": "red", "label": "Red" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "blue", "label": "Blue" },
        { "value": "green", "label": "Green" },
        { "value": "purple", "label": "Purple" }
      ],
      "default": "red"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F8F4EA"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "select",
      "id": "button_color",
      "label": "Button color",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "primary"
    }
  ]
}
{% endschema %}
