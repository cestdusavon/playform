{%- comment -%}
  Account header: greeting, trade badge when the customer is on a B2B company
  account, and the account nav.

  Accepts:
  - current: {String} 'account', 'addresses' or 'order' — marks the active tab.
{%- endcomment -%}

{%- liquid
  assign display_name = customer.first_name | default: customer.name | default: customer.email
  assign is_trade = false
  if customer.b2b?
    assign is_trade = true
  endif
-%}

<div class="pf-account-head">
  <div class="pf-account-head__intro">
    <p class="pf-eyebrow">{{ 'customer.account.title' | t }}</p>
    <h1 class="pf-display pf-account-head__title">
      {{ 'customer.account.welcome' | t: name: display_name }}
    </h1>

    {%- if is_trade -%}
      <p class="pf-account-badge">
        <span class="pf-status pf-status--blue">{{ 'customer.account.trade_account' | t }}</span>
        {%- if customer.current_company.name != blank -%}
          <span class="pf-account-badge__company">{{ customer.current_company.name }}</span>
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>

  <a class="pf-btn pf-btn--outline pf-account-head__out" href="{{ routes.account_logout_url }}">
    {{ 'customer.account.log_out' | t }}
  </a>
</div>

<nav class="pf-account-nav" aria-label="{{ 'customer.account.title' | t }}">
  <a
    class="pf-account-nav__link{% if current == 'account' %} is-active{% endif %}"
    href="{{ routes.account_url }}"
    {% if current == 'account' %}aria-current="page"{% endif %}>
    {{ 'customer.account.orders' | t }}
  </a>
  <a
    class="pf-account-nav__link{% if current == 'addresses' %} is-active{% endif %}"
    href="{{ routes.account_addresses_url }}"
    {% if current == 'addresses' %}aria-current="page"{% endif %}>
    {{ 'customer.addresses.title' | t }}
  </a>
  {%- if is_trade -%}
    <a class="pf-account-nav__link" href="/pages/rentals">
      {{ 'customer.account.view_rentals' | t }}
    </a>
  {%- endif -%}
</nav>
