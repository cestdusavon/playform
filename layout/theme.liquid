<!doctype html>
{%- capture pf_season -%}{% render 'pf-season' %}{%- endcapture -%}
<html lang="{{ request.locale.iso_code }}" data-season="{{ pf_season | strip }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_cream | default: '#F5F1E8' }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- liquid
      comment
        The title is assembled from a guaranteed-non-blank base so a page
        with no SEO title can never render as "– shop name" with a leading
        separator. Collections fall back to their own title, everything
        else to the shop name.
      endcomment
      assign pf_meta_title = page_title | strip
      if pf_meta_title == blank and collection
        assign pf_meta_title = collection.title
      endif
      if pf_meta_title == blank
        assign pf_meta_title = shop.name
      endif
      assign pf_tag_list = ''
      if current_tags
        assign pf_tag_list = current_tags | join: ', '
      endif
    -%}
    <title>
      {{ pf_meta_title }}
      {%- if pf_tag_list != blank %} &ndash; {{ 'general.meta.tags' | t: tags: pf_tag_list }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless pf_meta_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- liquid
      assign pf_meta_description = page_description
      if request.page_type == 'collection' and pf_meta_description == blank and collection.description != blank
        assign pf_meta_description = collection.description | strip_html | strip_newlines | truncate: 155
      endif
    -%}
    {%- if pf_meta_description != blank -%}
      <meta name="description" content="{{ pf_meta_description | escape }}">
    {%- endif -%}

    {%- liquid
      comment
        A collection with nothing in it stays crawlable (follow) but out of
        the index until it is stocked. The boolean collection metafield
        custom.index_when_empty opts a collection out — for the ones whose
        landing copy is the point even while the shelf is bare.
      endcomment
      if request.page_type == 'collection' and collection.all_products_count == 0
        unless collection.metafields.custom.index_when_empty.value == true
          echo '<meta name="robots" content="noindex, follow">'
        endunless
      endif
    -%}

    {%- if settings.use_google_fonts -%}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap">
    {%- endif -%}

    {{ content_for_header }}

    {{ 'playform.css' | asset_url | stylesheet_tag }}

    {%- style -%}
      {%- comment -%}
        The core tokens come from theme settings; the stylesheet holds the
        same values as its fallbacks. The seasonal accent is deliberately NOT
        emitted here — this block would otherwise outrank the [data-season]
        rules, which are in the linked stylesheet above.
      {%- endcomment -%}
      :root {
        --ptoys-bg: {{ settings.color_cream }};
        --ptoys-text: {{ settings.color_ink }};

        --pf-red: {{ settings.color_red }};
        --pf-yellow: {{ settings.color_yellow }};
        --pf-blue: {{ settings.color_blue }};
        --pf-green: {{ settings.color_green }};
        --pf-purple: {{ settings.color_purple }};
        --pf-radius: {{ settings.corner_radius }}px;
      }
    {%- endstyle -%}

    <script src="{{ 'playform.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="pf-body template-{{ request.page_type | handle }}">
    <a class="pf-skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="pf-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}
    {% render 'cart-drawer' %}
  </body>
</html>
