{%- paginate customer.addresses by 6 -%}
  <div class="pf-page pf-wrap">
    {% render 'pf-account-nav', current: 'addresses' %}

    <div class="pf-addresses-head">
      <h2 class="pf-display pf-account-heading">{{ 'customer.addresses.title' | t }}</h2>
      <button class="pf-btn" type="button" data-pf-address-toggle="AddressNew">
        {{ 'customer.addresses.add_new' | t }}
      </button>
    </div>

    <div class="pf-address-form" id="AddressNew" hidden>
      {%- form 'customer_address', customer.new_address -%}
        {% render 'pf-address-fields', form: form, address: customer.new_address, prefix: 'new' %}

        <div class="pf-address-form__actions">
          <button class="pf-btn" type="submit">{{ 'customer.addresses.save' | t }}</button>
          <button class="pf-btn pf-btn--outline" type="button" data-pf-address-toggle="AddressNew">
            {{ 'customer.addresses.cancel' | t }}
          </button>
        </div>
      {%- endform -%}
    </div>

    {%- if customer.addresses.size > 0 -%}
      <ul class="pf-address-grid" role="list">
        {%- for address in customer.addresses -%}
          <li class="pf-address-item">
            {%- if address == customer.default_address -%}
              <span class="pf-status pf-status--green pf-address-item__flag">
                {{- 'customer.account.default_address' | t -}}
              </span>
            {%- endif -%}

            <address class="pf-address-card">{{ address | format_address }}</address>

            <div class="pf-address-item__actions">
              <button
                class="pf-btn pf-btn--outline"
                type="button"
                data-pf-address-toggle="Address-{{ address.id }}">
                {{ 'customer.addresses.edit' | t }}
              </button>

              {%- comment -%}
                Shopify deletes an address through a POST to its URL with a
                _method override, so this is a plain form rather than a
                customer_address form.
              {%- endcomment -%}
              <form method="post" action="{{ address.url }}">
                <input type="hidden" name="_method" value="delete">
                <button
                  class="pf-btn pf-btn--outline"
                  type="submit"
                  data-pf-confirm="{{ 'customer.addresses.delete_confirm' | t | escape }}">
                  {{ 'customer.addresses.delete' | t }}
                </button>
              </form>
            </div>

            <div class="pf-address-form" id="Address-{{ address.id }}" hidden>
              {%- form 'customer_address', address -%}
                {% render 'pf-address-fields', form: form, address: address, prefix: address.id %}

                <div class="pf-address-form__actions">
                  <button class="pf-btn" type="submit">{{ 'customer.addresses.save' | t }}</button>
                  <button
                    class="pf-btn pf-btn--outline"
                    type="button"
                    data-pf-address-toggle="Address-{{ address.id }}">
                    {{ 'customer.addresses.cancel' | t }}
                  </button>
                </div>
              {%- endform -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="pf-muted">{{ 'customer.addresses.none' | t }}</p>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="pf-pagination" aria-label="{{ 'general.pagination.label' | t }}">
        {%- if paginate.previous -%}
          <a class="pf-pagination__link" href="{{ paginate.previous.url }}">
            {{ 'general.pagination.previous' | t }}
          </a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a class="pf-pagination__link" href="{{ part.url }}">{{ part.title }}</a>
          {%- else -%}
            <span class="pf-pagination__current">{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a class="pf-pagination__link" href="{{ paginate.next.url }}">
            {{ 'general.pagination.next' | t }}
          </a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  </div>
{%- endpaginate -%}
