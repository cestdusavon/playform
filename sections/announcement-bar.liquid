{%- liquid
  assign has_items = false
  if section.blocks.size > 0
    assign has_items = true
  endif
-%}

{%- if has_items -%}
  <div
    class="pf-ticker"
    data-animate="{{ section.settings.animate }}"
    style="background: {{ section.settings.background }}; color: {{ section.settings.text_color }};">
    <div class="pf-ticker__track">
      {%- comment -%}
        Two identical groups make the marquee loop seamlessly at -50%.
        The duplicate is hidden from assistive tech.
      {%- endcomment -%}
      {%- for pass in (1..2) -%}
        <div class="pf-ticker__group" {% if pass == 2 %}aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            {%- assign dot_color = block.settings.dot_color -%}
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="pf-ticker__item" {{ block.shopify_attributes }}>
            {%- else -%}<span class="pf-ticker__item" {{ block.shopify_attributes }}>{%- endif -%}
              {%- if block.settings.show_dot -%}
                <span class="pf-ticker__dot" style="background: {{ dot_color }};"></span>
              {%- endif -%}
              {{ block.settings.text }}
            {%- if block.settings.link != blank -%}</a>{%- else -%}</span>{%- endif -%}
          {%- endfor -%}

          {%- if section.settings.end_icon -%}
            <span class="pf-ticker__item" aria-hidden="true">{% render 'pf-icon', icon: 'arrow' %}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement ticker",
  "tag": "section",
  "class": "pf-section-ticker",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#F9C218" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#12100E" },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Scroll the messages",
      "info": "Scrolling is disabled automatically for visitors who prefer reduced motion.",
      "default": true
    },
    { "type": "checkbox", "id": "end_icon", "label": "Show arrow after the messages", "default": true }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Custom made" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "show_dot", "label": "Show brick", "default": true },
        { "type": "color", "id": "dot_color", "label": "Brick colour", "default": "#E63329" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement ticker",
      "blocks": [
        { "type": "message", "settings": { "text": "Custom made", "dot_color": "#E63329" } },
        { "type": "message", "settings": { "text": "3D printed", "dot_color": "#1156C4" } },
        { "type": "message", "settings": { "text": "Laser cut", "dot_color": "#7B3FB5" } },
        { "type": "message", "settings": { "text": "Hand finished", "dot_color": "#1E8A45" } },
        { "type": "message", "settings": { "text": "Made to play", "dot_color": "#E63329" } }
      ]
    }
  ]
}
{% endschema %}
