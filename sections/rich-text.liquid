{%- liquid
  assign alignment = section.settings.text_alignment
  assign background = section.settings.background_color
-%}

<div class="pf-rich-text" style="background: {{ background }};">
  <div class="pf-wrap">
    <div class="pf-rich-text__inner" style="text-align: {{ alignment }};">
      {%- if section.settings.heading != blank -%}
        <h2 class="pf-rich-text__heading">
          {% render 'pf-rainbow', text: section.settings.heading, start_color: section.settings.rainbow_start %}
        </h2>
      {%- endif -%}

      {%- if section.settings.content != blank -%}
        <div class="pf-rte">
          {{ section.settings.content }}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_url }}" class="pf-btn pf-btn--{{ section.settings.button_color }}">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .pf-rich-text {
    padding: 48px 0;
  }

  .pf-rich-text__inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .pf-rich-text__heading {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    margin-bottom: 24px;
    font-family: var(--pf-font-display);
    font-weight: 700;
  }

  .pf-rich-text .pf-rte {
    font-size: 1.125rem;
    line-height: 1.6;
    margin-bottom: 24px;
  }

  @media (max-width: 748px) {
    .pf-rich-text {
      padding: 32px 0;
    }
  }
</style>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "rainbow_start",
      "label": "Rainbow line start color",
      "options": [
        { "value": "red", "label": "Red" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "blue", "label": "Blue" },
        { "value": "green", "label": "Green" },
        { "value": "purple", "label": "Purple" }
      ],
      "default": "red"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F8F4EA"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "select",
      "id": "button_color",
      "label": "Button colour",
      "options": [
        { "value": "red", "label": "Red" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "blue", "label": "Blue" },
        { "value": "green", "label": "Green" },
        { "value": "purple", "label": "Purple" }
      ],
      "default": "red"
    }
  ]
}
{% endschema %}
