{%- comment -%}
  Custom project intake. Posts through Shopify's built-in contact form.
  Since the form can't accept file uploads, it asks for a link to reference
  images instead (Pinterest board, Instagram post, Google Drive, etc).
{%- endcomment -%}

<div class="pf-quote" style="background: {{ section.settings.background }};">
  <div class="pf-wrap">
    <div class="pf-quote__panel pf-quote--{{ section.settings.color }}">
      <div class="pf-quote__intro">
        <h2 class="pf-display pf-quote__title">
          {%- if section.settings.heading != blank -%}
            <span class="pf-line">{{ section.settings.heading | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading_accent != blank -%}
            <span class="pf-line" style="color: {{ section.settings.accent_color }};">
              {{- section.settings.heading_accent | escape -}}
            </span>
          {%- endif -%}
        </h2>

        {%- if section.settings.text != blank -%}
          <div class="pf-quote__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {%- form 'contact', id: 'CustomOrder', class: 'pf-quote__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="pf-quote__success">{{ section.settings.success_text | escape }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <div class="pf-quote__errors">{{ form.errors | default_errors }}</div>
          {%- endif -%}

          <input type="hidden" name="contact[enquiry_type]" value="Custom order">

          <div class="pf-quote__grid">
            <div class="pf-field">
              <label for="CustomName">Name</label>
              <input
                id="CustomName"
                type="text"
                name="contact[name]"
                value="{{ form.name | default: customer.name }}"
                autocomplete="name"
                required>
            </div>

            <div class="pf-field">
              <label for="CustomEmail">Email</label>
              <input
                id="CustomEmail"
                type="email"
                name="contact[email]"
                value="{{ form.email | default: customer.email }}"
                autocomplete="email"
                required>
            </div>

            <div class="pf-field">
              <label for="CustomType">What are we making?</label>
              <select id="CustomType" name="contact[project_type]">
                <option value="Nursery sign">Nursery sign</option>
                <option value="Toy / collectible">Toy / collectible</option>
                <option value="Prop">Prop</option>
                <option value="Something else">Something else</option>
              </select>
            </div>

            <div class="pf-field">
              <label for="CustomBudget">Rough budget</label>
              <select id="CustomBudget" name="contact[budget]">
                <option value="Under $50">Under $50</option>
                <option value="$50–150">$50–150</option>
                <option value="$150–400">$150–400</option>
                <option value="$400+">$400+</option>
                <option value="Not sure yet">Not sure yet</option>
              </select>
            </div>

            <div class="pf-field pf-field--wide">
              <label for="CustomReference">Link to reference images</label>
              <input
                id="CustomReference"
                type="text"
                name="contact[reference_link]"
                placeholder="Pinterest board, Instagram post, Google Drive…">
            </div>

            <div class="pf-field pf-field--wide">
              <label for="CustomBody">Describe the idea</label>
              <textarea id="CustomBody" name="contact[body]" rows="4" required>{{ form.body }}</textarea>
            </div>
          </div>

          <button class="pf-btn pf-btn--{{ section.settings.button_color }}" type="submit">
            {{ section.settings.button_label }}
          </button>

          {%- if section.settings.disclaimer != blank -%}
            <p class="pf-quote__disclaimer">{{ section.settings.disclaimer | escape }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom order form",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#F8F4EA" },
    {
      "type": "select",
      "id": "color",
      "label": "Panel colour",
      "options": [
        { "value": "red", "label": "Red" },
        { "value": "blue", "label": "Blue" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "green", "label": "Green" },
        { "value": "purple", "label": "Purple" }
      ],
      "default": "red"
    },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#F9C218" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Have Something Weird in Mind?" },
    { "type": "text", "id": "heading_accent", "label": "Accent line", "default": "Good. We Like Weird." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Send your sketch, reference or theme and we'll figure out how to make it. Most custom pieces get a quote back within 2–3 days.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send the idea" },
    {
      "type": "select",
      "id": "button_color",
      "label": "Button colour",
      "options": [
        { "value": "yellow", "label": "Yellow" },
        { "value": "red", "label": "Red" },
        { "value": "blue", "label": "Blue" },
        { "value": "green", "label": "Green" },
        { "value": "white", "label": "White" }
      ],
      "default": "yellow"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Got it! We'll come back with a quote within 2–3 days."
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "No payment is taken here — we'll send a quote first."
    }
  ],
  "presets": [{ "name": "Custom order form" }]
}
{% endschema %}
