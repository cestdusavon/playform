{%- comment -%}
  Colours each word of `text` by cycling through the brand palette.
  Usage: {% render 'pf-rainbow', text: section.settings.heading, start: 0 %}
{%- endcomment -%}
{%- liquid
  assign palette = 'red,yellow,blue,green,purple' | split: ','
  assign words = text | strip | split: ' '
  assign offset = start | default: 0
-%}
{%- for word in words -%}
  {%- assign slot = forloop.index0 | plus: offset | modulo: palette.size -%}
  <span class="pf-c-{{ palette[slot] }}">{{ word }}</span>{% unless forloop.last %} {% endunless %}
{%- endfor -%}
