<div class="pf-page pf-wrap">
  <div class="pf-auth pf-auth--single">
    <div class="pf-auth__card">
      {%- render 'pf-studs', count: 5 -%}

      <div class="pf-auth__body">
        <h1 class="pf-display pf-auth__title">{{ 'customer.reset_password.title' | t }}</h1>

        {%- form 'reset_customer_password' -%}
          {%- if form.errors -%}
            <div class="pf-notice pf-notice--error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="pf-field">
            <label for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
            <div class="pf-password">
              <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
              <button
                class="pf-password__toggle"
                type="button"
                data-pf-password-toggle="ResetPassword"
                data-label-show="{{ 'customer.login.show_password' | t | escape }}"
                data-label-hide="{{ 'customer.login.hide_password' | t | escape }}">
                {{ 'customer.login.show_password' | t }}
              </button>
            </div>
          </div>

          <div class="pf-field">
            <label for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
            <input
              id="ResetPasswordConfirm"
              type="password"
              name="customer[password_confirmation]"
              autocomplete="new-password"
              required>
          </div>

          <button class="pf-btn pf-btn--full" type="submit">{{ 'customer.reset_password.submit' | t }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>
