<div class="pf-page pf-wrap">
  <div class="pf-auth pf-auth--single">
    <div class="pf-auth__card">
      {%- render 'pf-studs', count: 5 -%}

      <div class="pf-auth__body">
        <h1 class="pf-display pf-auth__title">{{ 'customer.activate_account.title' | t }}</h1>
        <p class="pf-auth__subtitle">{{ 'customer.activate_account.subtitle' | t }}</p>

        {%- form 'activate_customer_password' -%}
          {%- if form.errors -%}
            <div class="pf-notice pf-notice--error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="pf-field">
            <label for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label>
            <div class="pf-password">
              <input
                id="ActivatePassword"
                type="password"
                name="customer[password]"
                autocomplete="new-password"
                required>
              <button
                class="pf-password__toggle"
                type="button"
                data-pf-password-toggle="ActivatePassword"
                data-label-show="{{ 'customer.login.show_password' | t | escape }}"
                data-label-hide="{{ 'customer.login.hide_password' | t | escape }}">
                {{ 'customer.login.show_password' | t }}
              </button>
            </div>
          </div>

          <div class="pf-field">
            <label for="ActivatePasswordConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
            <input
              id="ActivatePasswordConfirm"
              type="password"
              name="customer[password_confirmation]"
              autocomplete="new-password"
              required>
          </div>

          <button class="pf-btn pf-btn--full" type="submit">
            {{ 'customer.activate_account.submit' | t }}
          </button>

          <button class="pf-auth__link" type="submit" name="decline">
            {{ 'customer.activate_account.decline' | t }}
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>
