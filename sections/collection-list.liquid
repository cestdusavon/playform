{%- liquid
  assign collections_to_show = section.settings.collections_to_show | default: 3
  assign columns = section.settings.columns | default: 3
-%}

<div class="pf-collection-list" style="background: {{ section.settings.background_color }};">
  <div class="pf-wrap">
    {%- if section.settings.heading != blank -%}
      <div class="pf-section-header">
        <h2 class="pf-section-heading">
          {% render 'pf-rainbow', text: section.settings.heading, start_color: section.settings.rainbow_start %}
        </h2>
      </div>
    {%- endif -%}

    <div class="pf-collection-grid" style="--pf-grid-cols: {{ columns }};">
      {%- if section.settings.collection_list != blank -%}
        {%- assign collections = section.settings.collection_list -%}
        {%- for collection in collections limit: collections_to_show -%}
          <a href="{{ collection.url }}" class="pf-collection-card">
            <div class="pf-collection-card__image">
              {%- if collection.featured_image -%}
                {{
                  collection.featured_image
                  | image_url: width: 400
                  | image_tag:
                    alt: collection.title,
                    loading: 'lazy'
                }}
              {%- else -%}
                <div class="pf-collection-card__placeholder">
                  <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                    <rect width="200" height="200" fill="#E8E4DC"/>
                  </svg>
                </div>
              {%- endif -%}
            </div>
            <div class="pf-collection-card__content">
              <h3>{{ collection.title }}</h3>
              <p class="pf-text-small">{{ collection.products_count }} items</p>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="pf-text-center" style="margin-top: 32px;">
        <a href="{{ section.settings.button_url }}" class="pf-btn pf-btn--{{ section.settings.button_color }}">
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .pf-collection-list {
    padding: 48px 0;
  }

  .pf-section-header {
    text-align: center;
    margin-bottom: 48px;
  }

  .pf-section-heading {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    margin: 0 0 16px;
    font-family: var(--pf-font-display);
    font-weight: 700;
  }

  .pf-collection-grid {
    display: grid;
    grid-template-columns: repeat(var(--pf-grid-cols, 3), 1fr);
    gap: 24px;
  }

  .pf-collection-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--pf-radius, 20px);
    overflow: hidden;
    background: white;
    transition: transform 0.3s;
  }

  .pf-collection-card:hover {
    transform: translateY(-4px);
  }

  .pf-collection-card__image {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: #f5f5f5;
  }

  .pf-collection-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pf-collection-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pf-collection-card__placeholder svg {
    width: 100%;
    height: 100%;
  }

  .pf-collection-card__content {
    padding: 20px;
  }

  .pf-collection-card__content h3 {
    margin: 0 0 8px;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .pf-text-small {
    margin: 0;
    font-size: 0.875rem;
    color: #666;
  }

  .pf-text-center {
    text-align: center;
  }

  @media (max-width: 988px) {
    .pf-collection-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 748px) {
    .pf-collection-list {
      padding: 32px 0;
    }

    .pf-collection-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .pf-section-header {
      margin-bottom: 32px;
    }
  }
</style>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "rainbow_start",
      "label": "Rainbow line start color",
      "options": [
        { "value": "red", "label": "Red" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "blue", "label": "Blue" },
        { "value": "green", "label": "Green" },
        { "value": "purple", "label": "Purple" }
      ],
      "default": "red"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Collections"
    },
    {
      "type": "range",
      "id": "collections_to_show",
      "label": "Collections to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F8F4EA"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "select",
      "id": "button_color",
      "label": "Button colour",
      "options": [
        { "value": "red", "label": "Red" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "blue", "label": "Blue" },
        { "value": "green", "label": "Green" },
        { "value": "purple", "label": "Purple" }
      ],
      "default": "red"
    }
  ]
}
{% endschema %}
