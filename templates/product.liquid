{%- assign product_alt = product.featured_media.alt | default: product.title | escape -%}
<div class="pf-page pf-wrap">
  <div class="pf-product">
    <div class="pf-product__media">
      {%- if product.featured_media != blank -%}
        {{ product.featured_media | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 750px) 45vw, 90vw', alt: product_alt }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="pf-product__info">
      <h1 class="pf-display pf-page__title">{{ product.title | escape }}</h1>
      <p class="pf-product__price">{{ product.price | money }}</p>

      {%- form 'product', product -%}
        {%- if product.variants.size > 1 -%}
          <div class="pf-field">
            <label for="ProductVariant">{{ product.options_with_values.first.name }}</label>
            <select id="ProductVariant" name="id">
              {%- for variant in product.variants -%}
                <option
                  value="{{ variant.id }}"
                  {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                  {% unless variant.available %}disabled{% endunless %}>
                  {{ variant.title }} — {{ variant.price | money }}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- else -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- endif -%}

        <div class="pf-field">
          <label for="Quantity">{{ 'products.product.quantity' | t }}</label>
          <input id="Quantity" type="number" name="quantity" value="1" min="1">
        </div>

        <button class="pf-btn" type="submit" {% unless product.available %}disabled{% endunless %}>
          {%- if product.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </button>
      {%- endform -%}

      <div class="pf-rte">{{ product.description }}</div>
    </div>
  </div>
</div>
