{%- if cart.item_count > 0 -%}
  <div class="pf-cart-drawer" data-pf-cart-drawer>
    <div class="pf-cart-drawer__header">
      <h2>{{ 'cart.general.title' | t }}</h2>
      <button class="pf-cart-drawer__close" aria-label="{{ 'accessibility.close' | t }}" data-pf-cart-toggle>
        {% render 'pf-icon', icon: 'close' %}
      </button>
    </div>

    <div class="pf-cart-drawer__items">
      {%- for item in cart.items -%}
        <div class="pf-cart-item" data-cart-item="{{ item.index }}">
          <a href="{{ item.url }}" class="pf-cart-item__image">
            {%- if item.image -%}
              <img src="{{ item.image | image_url: width: 100 }}" alt="{{ item.title }}" loading="lazy">
            {%- endif -%}
          </a>

          <div class="pf-cart-item__details">
            <a href="{{ item.url }}" class="pf-cart-item__title">{{ item.product_title }}</a>
            {%- if item.variant_title != 'Default Title' -%}
              <p class="pf-cart-item__variant">{{ item.variant_title }}</p>
            {%- endif -%}
            <p class="pf-cart-item__quantity">{{ 'cart.general.qty' | t }}: {{ item.quantity }}</p>
            <p class="pf-cart-item__price">{{ item.line_price | money }}</p>
          </div>

          <button
            class="pf-cart-item__remove"
            aria-label="{{ 'cart.general.remove_notice' | t }}"
            data-cart-remove="{{ item.index }}"
          >
            {% render 'pf-icon', icon: 'close' %}
          </button>
        </div>
      {%- endfor -%}
    </div>

    <div class="pf-cart-drawer__summary">
      <div class="pf-cart-summary-row">
        <span>{{ 'cart.general.subtotal' | t }}</span>
        <span>{{ cart.items_subtotal_price | money }}</span>
      </div>
      {%- if cart.taxes_included -%}
        <p class="pf-text-small">{{ 'cart.general.taxes_included' | t }}</p>
      {%- endif -%}

      <a href="/cart" class="pf-btn pf-btn--primary pf-btn--full">
        {{ 'cart.general.view_cart' | t }}
      </a>
      <a href="/checkout" class="pf-btn pf-btn--secondary pf-btn--full">
        {{ 'cart.general.checkout' | t }}
      </a>
    </div>
  </div>
{%- else -%}
  <div class="pf-cart-drawer pf-cart-drawer--empty" data-pf-cart-drawer>
    <div class="pf-cart-drawer__header">
      <h2>{{ 'cart.general.title' | t }}</h2>
      <button class="pf-cart-drawer__close" aria-label="{{ 'accessibility.close' | t }}" data-pf-cart-toggle>
        {% render 'pf-icon', icon: 'close' %}
      </button>
    </div>
    <div class="pf-cart-drawer__empty">
      <p>{{ 'cart.general.empty' | t }}</p>
      <a href="/collections/all" class="pf-btn pf-btn--primary">
        {{ 'cart.general.continue_shopping' | t }}
      </a>
    </div>
  </div>
{%- endif -%}

<style>
  .pf-cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 420px;
    height: 100vh;
    background: var(--pf-color-cream, #F8F4EA);
    border-left: 1px solid var(--pf-color-ink, #12100E);
    display: flex;
    flex-direction: column;
    z-index: 99;
    box-shadow: -4px 0 16px rgba(0, 0, 0, 0.1);
    opacity: 0;
    transform: translateX(100%);
    transition: opacity 0.3s, transform 0.3s;
  }

  .pf-cart-drawer[data-pf-cart-drawer="open"] {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 748px) {
    .pf-cart-drawer {
      max-width: 100%;
    }
  }

  .pf-cart-drawer__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px;
    border-bottom: 1px solid var(--pf-color-ink, #12100E);
  }

  .pf-cart-drawer__header h2 {
    margin: 0;
    font-size: 1.5rem;
    font-family: var(--pf-font-display);
  }

  .pf-cart-drawer__close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pf-cart-drawer__items {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
  }

  .pf-cart-item {
    display: flex;
    gap: 16px;
    margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--pf-color-ink, #12100E);
  }

  .pf-cart-item:last-child {
    border-bottom: none;
  }

  .pf-cart-item__image {
    width: 100px;
    height: 100px;
    flex-shrink: 0;
    background: white;
    border-radius: var(--pf-radius, 20px);
    overflow: hidden;
  }

  .pf-cart-item__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pf-cart-item__details {
    flex: 1;
  }

  .pf-cart-item__title {
    display: block;
    margin: 0 0 8px;
    font-weight: 600;
    color: var(--pf-color-ink, #12100E);
    text-decoration: none;
  }

  .pf-cart-item__variant {
    margin: 0 0 8px;
    font-size: 0.875rem;
    color: #666;
  }

  .pf-cart-item__quantity,
  .pf-cart-item__price {
    margin: 4px 0;
    font-size: 0.875rem;
  }

  .pf-cart-item__remove {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    align-self: flex-start;
  }

  .pf-cart-drawer__summary {
    padding: 24px;
    border-top: 1px solid var(--pf-color-ink, #12100E);
  }

  .pf-cart-summary-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .pf-text-small {
    margin: 8px 0 16px;
    font-size: 0.75rem;
    color: #666;
  }

  .pf-cart-drawer--empty .pf-cart-drawer__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 24px;
    text-align: center;
  }

  .pf-cart-drawer--empty .pf-cart-drawer__items {
    display: none;
  }

  .pf-cart-drawer--empty .pf-cart-drawer__summary {
    border-top: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const cartDrawer = document.querySelector('[data-pf-cart-drawer]');
    if (!cartDrawer) return;

    const removeButtons = cartDrawer.querySelectorAll('[data-cart-remove]');
    removeButtons.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const index = this.dataset.cartRemove;
        fetch('/cart/change', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ id: index, quantity: 0 })
        }).then(() => location.reload());
      });
    });
  });
</script>
