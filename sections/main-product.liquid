{%- liquid
  assign media_position = section.settings.media_position
  assign product_alt = product.featured_media.alt | default: product.title | escape

  comment
    The variant picker owns the `id` field when it is on the page, so the buy
    buttons block must not render one too.
  endcomment
  assign has_picker = false
  for block in section.blocks
    if block.type == 'variant_picker'
      assign has_picker = true
      break
    endif
  endfor
  assign multi_variant = false
  if product.variants.size > 1
    assign multi_variant = true
  endif
-%}

<div class="pf-page pf-wrap">
  <div class="pf-product{% if media_position == 'right' %} pf-product--media-right{% endif %}">
    <div class="pf-product__media">
      {%- if product.featured_media != blank -%}
        {{
          product.featured_media
          | image_url: width: 1200
          | image_tag:
            widths: '400, 600, 900, 1200',
            sizes: '(min-width: 750px) 45vw, 90vw',
            alt: product_alt,
            class: 'pf-product__image'
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}

      {%- if section.settings.show_thumbs and product.media.size > 1 -%}
        <div class="pf-product__thumbs">
          {%- for media in product.media -%}
            <button
              class="pf-product__thumb"
              type="button"
              data-pf-media-swap="{{ media | image_url: width: 1200 }}"
              aria-label="{{ media.alt | default: product.title | escape }}">
              {{ media | image_url: width: 160 | image_tag: alt: media.alt, loading: 'lazy' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pf-product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <h1 class="pf-display pf-page__title" {{ block.shopify_attributes }}>
              {{- product.title | escape -}}
            </h1>

          {%- when 'price' -%}
            {%- assign current = product.selected_or_first_available_variant -%}
            <p class="pf-product__price" data-pf-price {{ block.shopify_attributes }}>
              <s data-pf-price-compare {% unless current.compare_at_price > current.price %}hidden{% endunless %}>
                {{- current.compare_at_price | money -}}
              </s>
              <span data-pf-price-current>{{ current.price | money }}</span>
            </p>

          {%- when 'vendor' -%}
            {%- if product.vendor != blank -%}
              <p class="pf-product__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
            {%- endif -%}

          {%- when 'text' -%}
            <div class="pf-rte pf-product__text" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>

          {%- when 'variant_picker' -%}
            {%- if multi_variant -%}
              <div class="pf-variant-picker" data-pf-variant-picker {{ block.shopify_attributes }}>
                {%- comment -%}
                  Rendered as one select over every variant, which submits on its
                  own with no JavaScript. The script below replaces it with one
                  control per option and keeps using it to carry the value.
                {%- endcomment -%}
                <div class="pf-field" data-pf-variant-fallback>
                  <label for="ProductVariant">
                    {{- product.options_with_values | map: 'name' | join: ' / ' -}}
                  </label>
                  <select id="ProductVariant" name="id" form="PfProductForm" data-pf-variant-select>
                    {%- for variant in product.variants -%}
                      <option
                        value="{{ variant.id }}"
                        {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                        {% unless variant.available %}disabled{% endunless %}>
                        {{ variant.title }} &mdash; {{ variant.price | money }}
                      </option>
                    {%- endfor -%}
                  </select>
                </div>

                <script type="application/json" data-pf-variant-data>
                  {
                    "style": {{ block.settings.picker_style | json }},
                    "soldOutLabel": {{ 'products.product.sold_out' | t | json }},
                    "unavailableLabel": {{ 'products.product.unavailable' | t | json }},
                    "addLabel": {{ 'products.product.add_to_cart' | t | json }},
                    "options": [
                      {%- for option in product.options_with_values -%}
                        {
                          "name": {{ option.name | json }},
                          "selected": {{ option.selected_value | json }},
                          "values": {{ option.values | json }}
                        }{% unless forloop.last %},{% endunless %}
                      {%- endfor -%}
                    ],
                    "variants": [
                      {%- for variant in product.variants -%}
                        {
                          "id": {{ variant.id }},
                          "options": {{ variant.options | json }},
                          "available": {{ variant.available }},
                          "price": {{ variant.price | money | json }},
                          "compareAtPrice": {{ variant.compare_at_price | money | json }},
                          "showCompare": {% if variant.compare_at_price > variant.price %}true{% else %}false{% endif %},
                          "image": {%- if variant.featured_media -%}
                            {{ variant.featured_media | image_url: width: 1200 | json }}
                          {%- else -%}null{%- endif -%}
                        }{% unless forloop.last %},{% endunless %}
                      {%- endfor -%}
                    ]
                  }
                </script>
              </div>
            {%- endif -%}

          {%- when 'custom_field' -%}
            {%- liquid
              assign field_label = block.settings.label | strip
              assign field_id = 'PfField-' | append: block.id
              assign field_type = block.settings.field_type
            -%}
            {%- if field_label != blank -%}
              <div class="pf-field pf-field--custom" {{ block.shopify_attributes }}>
                <label for="{{ field_id }}">
                  {{ field_label }}
                  {%- if block.settings.required -%}
                    <span class="pf-field__required" aria-hidden="true">*</span>
                  {%- endif -%}
                </label>

                {%- if block.settings.help != blank -%}
                  <p class="pf-field__help" id="{{ field_id }}-help">{{ block.settings.help }}</p>
                {%- endif -%}

                {%- liquid
                  assign field_name = 'properties[' | append: field_label | append: ']'
                  assign described = ''
                  if block.settings.help != blank
                    assign described = field_id | append: '-help'
                  endif
                -%}

                {%- case field_type -%}
                  {%- when 'textarea' -%}
                    <textarea
                      id="{{ field_id }}"
                      name="{{ field_name | escape }}"
                      form="PfProductForm"
                      rows="3"
                      {% if block.settings.max_length > 0 %}maxlength="{{ block.settings.max_length }}"{% endif %}
                      {% if block.settings.placeholder != blank %}placeholder="{{ block.settings.placeholder | escape }}"{% endif %}
                      {% if described != blank %}aria-describedby="{{ described }}"{% endif %}
                      {% if block.settings.required %}required{% endif %}></textarea>

                  {%- when 'select' -%}
                    <select
                      id="{{ field_id }}"
                      name="{{ field_name | escape }}"
                      form="PfProductForm"
                      {% if described != blank %}aria-describedby="{{ described }}"{% endif %}
                      {% if block.settings.required %}required{% endif %}>
                      {%- unless block.settings.required -%}
                        <option value="">{{ 'products.product.choose' | t }}</option>
                      {%- endunless -%}
                      {%- assign choices = block.settings.options | split: ',' -%}
                      {%- for choice in choices -%}
                        {%- assign choice_value = choice | strip -%}
                        {%- if choice_value != blank -%}
                          <option value="{{ choice_value | escape }}">{{ choice_value }}</option>
                        {%- endif -%}
                      {%- endfor -%}
                    </select>

                  {%- when 'number' -%}
                    <input
                      id="{{ field_id }}"
                      type="number"
                      name="{{ field_name | escape }}"
                      form="PfProductForm"
                      {% if block.settings.min_number != blank %}min="{{ block.settings.min_number }}"{% endif %}
                      {% if block.settings.max_number != blank %}max="{{ block.settings.max_number }}"{% endif %}
                      {% if block.settings.placeholder != blank %}placeholder="{{ block.settings.placeholder | escape }}"{% endif %}
                      {% if described != blank %}aria-describedby="{{ described }}"{% endif %}
                      {% if block.settings.required %}required{% endif %}>

                  {%- when 'checkbox' -%}
                    <label class="pf-field__check">
                      <input
                        id="{{ field_id }}"
                        type="checkbox"
                        name="{{ field_name | escape }}"
                        value="{{ 'products.product.yes' | t }}"
                        form="PfProductForm"
                        {% if described != blank %}aria-describedby="{{ described }}"{% endif %}
                        {% if block.settings.required %}required{% endif %}>
                      <span>{{ block.settings.placeholder | default: field_label }}</span>
                    </label>

                  {%- else -%}
                    <input
                      id="{{ field_id }}"
                      type="text"
                      name="{{ field_name | escape }}"
                      form="PfProductForm"
                      {% if block.settings.max_length > 0 %}maxlength="{{ block.settings.max_length }}"{% endif %}
                      {% if block.settings.placeholder != blank %}placeholder="{{ block.settings.placeholder | escape }}"{% endif %}
                      {% if described != blank %}aria-describedby="{{ described }}"{% endif %}
                      {% if block.settings.required %}required{% endif %}>
                {%- endcase -%}

                {%- if block.settings.max_length > 0 -%}
                  {%- if field_type == 'text' or field_type == 'textarea' -%}
                    <p class="pf-field__count" data-pf-count-for="{{ field_id }}" data-pf-count-max="{{ block.settings.max_length }}"></p>
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'rental_rates' -%}
            <div {{ block.shopify_attributes }}>
              {% render 'pf-rental-rates', product: product, layout: block.settings.layout %}
            </div>

          {%- when 'buy_buttons' -%}
            <div {{ block.shopify_attributes }}>
              {%- form 'product', product, id: 'PfProductForm' -%}
                {%- comment -%}
                  With a variant picker block on the page the select lives there
                  and is tied back to this form by its `form` attribute.
                {%- endcomment -%}
                {%- unless has_picker and multi_variant -%}
                  {%- if multi_variant -%}
                    <div class="pf-field">
                      <label for="ProductVariant">
                        {{- product.options_with_values | map: 'name' | join: ' / ' -}}
                      </label>
                      <select id="ProductVariant" name="id">
                        {%- for variant in product.variants -%}
                          <option
                            value="{{ variant.id }}"
                            {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                            {% unless variant.available %}disabled{% endunless %}>
                            {{ variant.title }} &mdash; {{ variant.price | money }}
                          </option>
                        {%- endfor -%}
                      </select>
                    </div>
                  {%- else -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  {%- endif -%}
                {%- endunless -%}

                {%- if block.settings.show_quantity -%}
                  <div class="pf-field">
                    <label for="Quantity">{{ 'products.product.quantity' | t }}</label>
                    <input id="Quantity" type="number" name="quantity" value="1" min="1">
                  </div>
                {%- endif -%}

                <button
                  class="pf-btn pf-btn--{{ block.settings.button_color }}"
                  type="submit"
                  data-pf-add-button
                  {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
                  {%- if product.selected_or_first_available_variant.available -%}
                    {{ 'products.product.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </button>
              {%- endform -%}
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="pf-rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var form = document.getElementById('PfProductForm');
    if (!form) return;

    /* Live character counters. */
    var counters = document.querySelectorAll('[data-pf-count-for]');
    Array.prototype.forEach.call(counters, function (counter) {
      var field = document.getElementById(counter.dataset.pfCountFor);
      if (!field) return;

      var max = Number(counter.dataset.pfCountMax);
      var template = {{ 'products.product.characters_left' | t: count: '[n]' | json }};

      function render() {
        var left = max - field.value.length;
        counter.textContent = template.replace('[n]', left);
        counter.classList.toggle('is-low', left <= 5);
      }

      field.addEventListener('input', render);
      render();
    });

    /* An optional field left blank would otherwise reach the order as an empty
       line item property. Disabling it keeps it off the order entirely. */
    form.addEventListener('submit', function () {
      Array.prototype.forEach.call(form.elements, function (element) {
        if (!element.name || element.name.indexOf('properties[') !== 0) return;
        if (element.required) return;
        if (element.type === 'checkbox') return;
        if (element.value.trim() === '') element.disabled = true;
      });
    });
  })();
</script>

<script>
  (function () {
    var root = document.querySelector('[data-pf-variant-picker]');
    if (!root) return;

    var carrier = root.querySelector('[data-pf-variant-select]');
    var fallback = root.querySelector('[data-pf-variant-fallback]');
    var data;

    try {
      data = JSON.parse(root.querySelector('[data-pf-variant-data]').textContent);
    } catch (error) {
      return; /* leave the plain variant select in place */
    }

    var priceCurrent = document.querySelector('[data-pf-price-current]');
    var priceCompare = document.querySelector('[data-pf-price-compare]');
    var addButton = document.querySelector('[data-pf-add-button]');
    var featured = document.querySelector('.pf-product__image');
    var controls = [];

    function selected() {
      return controls.map(function (control) {
        return control.value;
      });
    }

    function match(values) {
      return data.variants.filter(function (variant) {
        return variant.options.every(function (value, index) {
          return value === values[index];
        });
      })[0];
    }

    /* A value is offered only if some variant pairs it with the other choices. */
    function reachable(optionIndex, value) {
      var values = selected();
      values[optionIndex] = value;
      return data.variants.some(function (variant) {
        return variant.options.every(function (option, index) {
          return index === optionIndex ? option === value : option === values[index];
        });
      });
    }

    function update() {
      var variant = match(selected());

      controls.forEach(function (control, index) {
        Array.prototype.forEach.call(control.options || control.querySelectorAll('input'), function (node) {
          var value = node.value;
          var ok = reachable(index, value);
          if (node.tagName === 'OPTION') {
            node.disabled = !ok;
          } else {
            node.disabled = !ok;
            node.parentNode.classList.toggle('is-unavailable', !ok);
          }
        });
      });

      if (!variant) {
        carrier.value = '';
        if (addButton) {
          addButton.disabled = true;
          addButton.textContent = data.unavailableLabel;
        }
        return;
      }

      carrier.value = variant.id;

      if (addButton) {
        addButton.disabled = !variant.available;
        addButton.textContent = variant.available ? data.addLabel : data.soldOutLabel;
      }

      if (priceCurrent) priceCurrent.textContent = variant.price;
      if (priceCompare) {
        priceCompare.textContent = variant.compareAtPrice || '';
        priceCompare.hidden = !variant.showCompare;
      }

      if (variant.image && featured) {
        featured.removeAttribute('srcset');
        featured.removeAttribute('sizes');
        featured.src = variant.image;
      }

      if (window.history && history.replaceState) {
        var url = new URL(window.location.href);
        url.searchParams.set('variant', variant.id);
        history.replaceState({}, '', url.toString());
      }
    }

    data.options.forEach(function (option, index) {
      var field = document.createElement('div');
      field.className = 'pf-field';

      var id = 'PfOption' + index;
      var label = document.createElement('label');
      label.setAttribute('for', id);
      label.textContent = option.name;
      field.appendChild(label);

      var control;
      if (data.style === 'buttons') {
        control = document.createElement('div');
        control.className = 'pf-variant-options';
        control.id = id;

        option.values.forEach(function (value) {
          var wrap = document.createElement('label');
          wrap.className = 'pf-variant-option';

          var input = document.createElement('input');
          input.type = 'radio';
          input.name = 'pf-option-' + index;
          input.value = value;
          input.checked = value === option.selected;

          wrap.appendChild(input);
          wrap.appendChild(document.createTextNode(value));
          control.appendChild(wrap);
        });

        Object.defineProperty(control, 'value', {
          get: function () {
            var checked = control.querySelector('input:checked');
            return checked ? checked.value : null;
          }
        });
      } else {
        control = document.createElement('select');
        control.id = id;
        option.values.forEach(function (value) {
          var node = document.createElement('option');
          node.value = value;
          node.textContent = value;
          node.selected = value === option.selected;
          control.appendChild(node);
        });
      }

      control.addEventListener('change', update);
      field.appendChild(control);
      root.insertBefore(field, fallback);
      controls.push(control);
    });

    fallback.hidden = true;
    update();
  })();
</script>

{%- if section.settings.show_thumbs -%}
  <script>
    document.addEventListener('click', function (event) {
      var thumb = event.target.closest('[data-pf-media-swap]');
      if (!thumb) return;

      var featured = document.querySelector('.pf-product__image');
      if (!featured) return;

      featured.removeAttribute('srcset');
      featured.removeAttribute('sizes');
      featured.src = thumb.dataset.pfMediaSwap;
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_thumbs",
      "label": "Show thumbnails",
      "info": "Only appears when the product has more than one image.",
      "default": true
    }
  ],
  "blocks": [
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "One control per option (Size, Colour…). Products with a single variant show nothing."
        },
        {
          "type": "select",
          "id": "picker_style",
          "label": "Style",
          "options": [
            { "value": "dropdown", "label": "Dropdowns" },
            { "value": "buttons", "label": "Buttons" }
          ],
          "default": "dropdown"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Show quantity", "default": true },
        {
          "type": "select",
          "id": "button_color",
          "label": "Button colour",
          "options": [
            { "value": "red", "label": "Red" },
            { "value": "yellow", "label": "Yellow" },
            { "value": "blue", "label": "Blue" },
            { "value": "green", "label": "Green" },
            { "value": "purple", "label": "Purple" }
          ],
          "default": "red"
        }
      ]
    },
    {
      "type": "custom_field",
      "name": "Personalisation field",
      "settings": [
        {
          "type": "paragraph",
          "content": "One input the customer fills in. Add a block per field. The label is what prints on the order, so keep it short and specific — \"Name on sign\", not \"Text\"."
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Name on sign" },
        {
          "type": "select",
          "id": "field_type",
          "label": "Type",
          "options": [
            { "value": "text", "label": "Single line" },
            { "value": "textarea", "label": "Paragraph" },
            { "value": "select", "label": "Choice list" },
            { "value": "number", "label": "Number" },
            { "value": "checkbox", "label": "Tick box" }
          ],
          "default": "text"
        },
        {
          "type": "text",
          "id": "options",
          "label": "Choices",
          "info": "Choice list only. Comma separated, e.g. Small, Medium, Large.",
          "default": "Small, Medium, Large"
        },
        { "type": "text", "id": "placeholder", "label": "Placeholder" },
        { "type": "text", "id": "help", "label": "Help text", "info": "Shown under the label." },
        { "type": "checkbox", "id": "required", "label": "Required", "default": false },
        {
          "type": "range",
          "id": "max_length",
          "label": "Character limit",
          "info": "Single line and paragraph only. 0 for no limit.",
          "min": 0,
          "max": 200,
          "step": 5,
          "default": 0
        },
        { "type": "text", "id": "min_number", "label": "Minimum", "info": "Number only." },
        { "type": "text", "id": "max_number", "label": "Maximum", "info": "Number only." }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "rental_rates",
      "name": "Rental rates",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "options": [
            { "value": "table", "label": "Rate table" },
            { "value": "inline", "label": "Inline" }
          ],
          "default": "table"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [{ "type": "richtext", "id": "text", "label": "Text" }]
    }
  ]
}
{% endschema %}
