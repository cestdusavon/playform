<div class="pf-steps" style="background: {{ section.settings.background }};">
  <div class="pf-wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="pf-display pf-steps__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="pf-steps__list" style="--pf-step-count: {{ section.blocks.size }};">
      {%- for block in section.blocks -%}
        <div class="pf-step pf-step--{{ block.settings.color }}" {{ block.shopify_attributes }}>
          <div class="pf-step__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 320
                | image_tag: loading: 'lazy', widths: '160, 240, 320', sizes: '160px', alt: block.settings.image.alt
              }}
            {%- elsif block.settings.emoji != blank -%}
              <span class="pf-step__glyph" aria-hidden="true">{{ block.settings.emoji }}</span>
            {%- endif -%}
          </div>

          <div class="pf-step__heading">
            <span class="pf-step__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3 class="pf-step__title">{{ block.settings.title | escape }}</h3>
          </div>

          {%- if block.settings.text != blank -%}
            <p class="pf-step__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "How it's made",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#F8F4EA" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made Different." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "color",
          "label": "Number colour",
          "options": [
            { "value": "blue", "label": "Blue" },
            { "value": "yellow", "label": "Yellow" },
            { "value": "red", "label": "Red" },
            { "value": "green", "label": "Green" },
            { "value": "purple", "label": "Purple" }
          ],
          "default": "blue"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Designed" },
        { "type": "textarea", "id": "text", "label": "Description" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "emoji", "label": "Emoji", "info": "Shown when no image is set." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it's made",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "color": "blue",
            "title": "Designed",
            "text": "Original pieces modeled specifically for Playform.",
            "emoji": "🖥️"
          }
        },
        {
          "type": "step",
          "settings": {
            "color": "yellow",
            "title": "Printed + cut",
            "text": "3D printing, resin printing and precision laser cutting.",
            "emoji": "🖨️"
          }
        },
        {
          "type": "step",
          "settings": {
            "color": "red",
            "title": "Finished by hand",
            "text": "Sanded, assembled, painted and detailed individually.",
            "emoji": "🖌️"
          }
        },
        {
          "type": "step",
          "settings": {
            "color": "green",
            "title": "Made for you",
            "text": "Custom colors, names, sizing and designs.",
            "emoji": "🎁"
          }
        }
      ]
    }
  ]
}
{% endschema %}
