<!doctype html>
{%- capture pf_season -%}{% render 'pf-season' %}{%- endcapture -%}
<html lang="{{ request.locale.iso_code }}" data-season="{{ pf_season | strip }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {{ 'playform.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="pf-body">
    <main class="pf-main">{{ content_for_layout }}</main>
  </body>
</html>
