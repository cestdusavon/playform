{% layout 'password' %}
<div class="pf-page pf-wrap">
  <h1 class="pf-display pf-page__title">{{ shop.name }}</h1>
  <div class="pf-rte pf-page__intro">{{ shop.password_message }}</div>

  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <div class="pf-field">
      <label for="StorefrontPassword">Password</label>
      <input id="StorefrontPassword" type="password" name="password" autocomplete="current-password">
    </div>
    <button class="pf-btn" type="submit">Enter</button>
  {%- endform -%}
</div>
