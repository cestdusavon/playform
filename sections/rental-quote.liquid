<div class="pf-quote" style="background: {{ section.settings.background }};">
  <div class="pf-wrap">
    <div class="pf-quote__panel pf-quote--{{ section.settings.color }}">
      <div class="pf-quote__intro">
        <h2 class="pf-display pf-quote__title">
          {%- if section.settings.heading != blank -%}
            <span class="pf-line">{{ section.settings.heading | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading_accent != blank -%}
            <span class="pf-line" style="color: {{ section.settings.accent_color }};">
              {{- section.settings.heading_accent | escape -}}
            </span>
          {%- endif -%}
        </h2>

        {%- if section.settings.text != blank -%}
          <div class="pf-quote__text">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {%- form 'contact', id: 'RentalQuote', class: 'pf-quote__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="pf-quote__success">{{ section.settings.success_text | escape }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <div class="pf-quote__errors">{{ form.errors | default_errors }}</div>
          {%- endif -%}

          <input type="hidden" name="contact[enquiry_type]" value="Rental quote">

          <div class="pf-quote__grid">
            <div class="pf-field">
              <label for="QuoteCompany">Company / organisation</label>
              <input id="QuoteCompany" type="text" name="contact[company]" autocomplete="organization" required>
            </div>

            <div class="pf-field">
              <label for="QuoteName">Contact name</label>
              <input
                id="QuoteName"
                type="text"
                name="contact[name]"
                value="{{ form.name | default: customer.name }}"
                autocomplete="name"
                required>
            </div>

            <div class="pf-field">
              <label for="QuoteEmail">Email</label>
              <input
                id="QuoteEmail"
                type="email"
                name="contact[email]"
                value="{{ form.email | default: customer.email }}"
                autocomplete="email"
                required>
            </div>

            <div class="pf-field">
              <label for="QuotePhone">Phone</label>
              <input id="QuotePhone" type="tel" name="contact[phone]" autocomplete="tel">
            </div>

            <div class="pf-field">
              <label for="QuoteDate">Event date</label>
              <input id="QuoteDate" type="date" name="contact[event_date]">
            </div>

            <div class="pf-field">
              <label for="QuoteDuration">Hire period</label>
              <select id="QuoteDuration" name="contact[hire_period]">
                <option value="1 day">1 day</option>
                <option value="Weekend">Weekend (Fri–Mon)</option>
                <option value="1 week">1 week</option>
                <option value="1 month">1 month</option>
                <option value="Longer / not sure">Longer, or not sure yet</option>
              </select>
            </div>

            <div class="pf-field pf-field--wide">
              <label for="QuoteVenue">Venue &amp; delivery address</label>
              <input id="QuoteVenue" type="text" name="contact[venue]">
            </div>

            <div class="pf-field pf-field--wide">
              <label for="QuoteItems">What do you need?</label>
              <textarea id="QuoteItems" name="contact[body]" rows="4" required>{{ form.body }}</textarea>
            </div>

            <div class="pf-field pf-field--wide pf-field--check">
              <input id="QuoteDelivery" type="checkbox" name="contact[delivery_required]" value="Yes">
              <label for="QuoteDelivery">I need delivery, install and strike quoted too</label>
            </div>
          </div>

          <button class="pf-btn pf-btn--{{ section.settings.button_color }}" type="submit">
            {{ section.settings.button_label }}
          </button>

          {%- if section.settings.disclaimer != blank -%}
            <p class="pf-quote__disclaimer">{{ section.settings.disclaimer | escape }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Rental quote request",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#F8F4EA" },
    {
      "type": "select",
      "id": "color",
      "label": "Panel colour",
      "options": [
        { "value": "blue", "label": "Blue" },
        { "value": "red", "label": "Red" },
        { "value": "yellow", "label": "Yellow" },
        { "value": "green", "label": "Green" },
        { "value": "purple", "label": "Purple" }
      ],
      "default": "blue"
    },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#F9C218" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell Us What You're Building." },
    { "type": "text", "id": "heading_accent", "label": "Accent line", "default": "We'll Quote It in 48 Hours." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Send the brief — pieces, dates, venue — and we'll come back with hire rates, the deposit, and a delivery cost. Trade accounts get a standing rate card.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Request a quote" },
    {
      "type": "select",
      "id": "button_color",
      "label": "Button colour",
      "options": [
        { "value": "yellow", "label": "Yellow" },
        { "value": "red", "label": "Red" },
        { "value": "blue", "label": "Blue" },
        { "value": "green", "label": "Green" },
        { "value": "purple", "label": "Purple" },
        { "value": "white", "label": "White" }
      ],
      "default": "yellow"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Got it. We'll come back to you inside 48 hours with rates and availability."
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "Quotes hold for 14 days. Dates are only held once the deposit clears."
    }
  ],
  "presets": [{ "name": "Rental quote request" }]
}
{% endschema %}
