<div class="pf-trade" style="background: {{ section.settings.background }}; color: {{ section.settings.text_color }};">
  <div class="pf-wrap pf-trade__inner">
    <div class="pf-trade__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="pf-eyebrow pf-trade__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h1 class="pf-display pf-trade__title">
        {%- if section.settings.heading != blank -%}
          <span class="pf-line">{{ section.settings.heading | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading_accent != blank -%}
          <span class="pf-line" style="color: {{ section.settings.accent_color }};">
            {{- section.settings.heading_accent | escape -}}
          </span>
        {%- endif -%}
      </h1>

      {%- if section.settings.text != blank -%}
        <div class="pf-trade__text">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="pf-trade__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="pf-btn pf-btn--{{ section.settings.button_color }}" href="{{ section.settings.button_link }}">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="pf-btn pf-btn--outline pf-btn--outline-light" href="{{ section.settings.button_2_link }}">
            {{ section.settings.button_2_label }}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <dl class="pf-trade__stats">
        {%- for block in section.blocks -%}
          <div class="pf-trade__stat" {{ block.shopify_attributes }}>
            <dt class="pf-trade__stat-value">{{ block.settings.value | escape }}</dt>
            <dd class="pf-trade__stat-label">{{ block.settings.label | escape }}</dd>
          </div>
        {%- endfor -%}
      </dl>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Rentals hero",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#1156C4" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#F9C218" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Trade & B2B" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Prop Rentals for" },
    { "type": "text", "id": "heading_accent", "label": "Accent line", "default": "People Who Throw Big." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Oversized letters, themed set pieces and party props, hired by event planners, venues, photographers and brand teams. Day, weekend, weekly and monthly rates with a refundable deposit.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Request a quote" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "button_color",
      "label": "Button colour",
      "options": [
        { "value": "yellow", "label": "Yellow" },
        { "value": "red", "label": "Red" },
        { "value": "blue", "label": "Blue" },
        { "value": "green", "label": "Green" },
        { "value": "purple", "label": "Purple" },
        { "value": "white", "label": "White" }
      ],
      "default": "yellow"
    },
    { "type": "text", "id": "button_2_label", "label": "Second button label", "default": "See the rate card" },
    { "type": "url", "id": "button_2_link", "label": "Second button link" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "500+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Events supplied" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rentals hero",
      "blocks": [
        { "type": "stat", "settings": { "value": "500+", "label": "Events supplied" } },
        { "type": "stat", "settings": { "value": "48h", "label": "Quote turnaround" } },
        { "type": "stat", "settings": { "value": "30%", "label": "Refundable deposit" } }
      ]
    }
  ]
}
{% endschema %}
