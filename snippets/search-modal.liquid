<div class="pf-search-modal" data-pf-search-modal>
  <div class="pf-search-modal__backdrop" data-pf-search-close></div>

  <div class="pf-search-modal__content">
    <div class="pf-search-modal__header">
      <form action="/search" method="get" class="pf-search-form">
        <input
          type="search"
          name="q"
          placeholder="{{ 'header.search.placeholder' | t }}"
          class="pf-search-form__input"
          aria-label="{{ 'header.search.placeholder' | t }}"
          autocomplete="off"
          data-pf-search-input
        >
        <button type="submit" class="pf-search-form__submit" aria-label="{{ 'header.search.submit' | t }}">
          {% render 'pf-icon', icon: 'search' %}
        </button>
      </form>

      <button
        class="pf-search-modal__close"
        aria-label="{{ 'accessibility.close' | t }}"
        data-pf-search-close
      >
        {% render 'pf-icon', icon: 'close' %}
      </button>
    </div>

    <div class="pf-search-modal__results" data-pf-search-results>
      <p class="pf-search-modal__empty">{{ 'header.search.empty' | t }}</p>
    </div>
  </div>
</div>

<style>
  .pf-search-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 98;
    display: none;
    flex-direction: column;
  }

  .pf-search-modal[data-pf-search-modal="open"] {
    display: flex;
  }

  .pf-search-modal__backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.3);
    z-index: 1;
  }

  .pf-search-modal__content {
    position: relative;
    z-index: 2;
    background: var(--pf-color-cream, #F8F4EA);
    display: flex;
    flex-direction: column;
    max-height: 80vh;
  }

  .pf-search-modal__header {
    display: flex;
    gap: 12px;
    padding: 24px;
    border-bottom: 1px solid var(--pf-color-ink, #12100E);
  }

  .pf-search-form {
    flex: 1;
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .pf-search-form__input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: 1.125rem;
    font-family: inherit;
    color: var(--pf-color-ink, #12100E);
  }

  .pf-search-form__input::placeholder {
    color: #999;
  }

  .pf-search-form__input:focus {
    outline: none;
  }

  .pf-search-form__submit {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--pf-color-ink, #12100E);
  }

  .pf-search-modal__close {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--pf-color-ink, #12100E);
  }

  .pf-search-modal__results {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
  }

  .pf-search-modal__empty {
    text-align: center;
    color: #666;
    margin: 0;
  }

  .pf-search-result {
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--pf-color-ink, #12100E);
  }

  .pf-search-result:last-child {
    border-bottom: none;
  }

  .pf-search-result__link {
    display: block;
    color: var(--pf-color-ink, #12100E);
    text-decoration: none;
    font-weight: 500;
  }

  .pf-search-result__link:hover {
    text-decoration: underline;
  }

  .pf-search-result__type {
    font-size: 0.75rem;
    color: #999;
    margin-top: 4px;
  }

  @media (max-width: 748px) {
    .pf-search-modal__header {
      padding: 16px;
    }

    .pf-search-modal__results {
      padding: 16px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const searchModal = document.querySelector('[data-pf-search-modal]');
    if (!searchModal) return;

    const searchInput = searchModal.querySelector('[data-pf-search-input]');
    const resultsContainer = searchModal.querySelector('[data-pf-search-results]');
    const closeButtons = searchModal.querySelectorAll('[data-pf-search-close]');

    closeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        searchModal.removeAttribute('data-pf-search-modal');
      });
    });

    searchInput.addEventListener('input', debounce(function() {
      const query = this.value.trim();
      if (query.length === 0) {
        resultsContainer.innerHTML = '<p class="pf-search-modal__empty">{{ "header.search.empty" | t }}</p>';
        return;
      }

      fetch(`/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product&resources[limit]=8`)
        .then(r => r.json())
        .then(data => {
          if (!data.resources.results.products || data.resources.results.products.length === 0) {
            resultsContainer.innerHTML = '<p class="pf-search-modal__empty">{{ "header.search.empty" | t }}</p>';
            return;
          }

          resultsContainer.innerHTML = data.resources.results.products
            .map(p => `
              <div class="pf-search-result">
                <a href="${p.url}" class="pf-search-result__link">${p.title}</a>
                <div class="pf-search-result__type">{{ "header.search.product" | t }}</div>
              </div>
            `)
            .join('');
        });
    }, 300));

    function debounce(fn, delay) {
      let timeout;
      return function() {
        clearTimeout(timeout);
        timeout = setTimeout(() => fn.apply(this, arguments), delay);
      };
    }
  });
</script>
